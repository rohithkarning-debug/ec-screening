# ---------------------------------------------------------------------------
# Environment configuration (D4). Copy to .env:   cp .env.example .env
# .env is git-ignored. No real credential, provider endpoint or model name
# belongs in this file or anywhere else in the repository.
#
# As shipped, the gateway points at the bundled stub LLM, so `docker compose up`
# works with no account. The stub follows a fixed script and CANNOT reason:
# for evaluation and the demo, set the three LLM_PROVIDER_* / LLM_MODEL values
# to a real OpenAI-compatible provider (a free tier is enough).
# ---------------------------------------------------------------------------

# --- internal service addresses (Compose service names) ---------------------
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=eia_corpus
LLM_GATEWAY_URL=http://llm-gateway:8080
VERIFIER_URL=http://verifier:8070
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- embeddings --------------------------------------------------------------
# minilm = all-MiniLM-L6-v2 run locally via ONNX (free). hash = tests only.
EMBEDDING_BACKEND=minilm

# --- LLM provider (read by llm-gateway only) ----------------------------------
# Any OpenAI-compatible chat-completions API: base URL ending in /v1 (or the
# provider's equivalent), an API key, and a model identifier from its docs.
LLM_PROVIDER_BASE_URL=http://llm-stub:8090/v1
LLM_PROVIDER_API_KEY=
LLM_MODEL=stub
# Optional second provider used when the primary's circuit breaker is open.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Price per 1M tokens in USD, for cost tracking (L5). Free tier = 0; set the
# provider's paid list price to report a shadow cost.
LLM_PRICE_INPUT_PER_1M_USD=0
LLM_PRICE_OUTPUT_PER_1M_USD=0

# --- stub LLM (D6) ------------------------------------------------------------
STUB_DELAY_MS=1500
STUB_FAIL_RATE=0

# --- agent limits (A1) --------------------------------------------------------
PROMPT_VERSION=v2
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_RUN_SECONDS=90
AGENT_MAX_VERIFY_RETRIES=1

# --- reliability (A5) ---------------------------------------------------------
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
TOOL_TIMEOUT_SECONDS=10
VERIFIER_TIMEOUT_SECONDS=45
BREAKER_FAIL_THRESHOLD=5
BREAKER_RESET_SECONDS=30

# --- platform controls (D7, L6) -----------------------------------------------
RATE_LIMIT_PER_MINUTE=30
RUN_CACHE_ENABLED=1
RUN_CACHE_TTL_SECONDS=3600
LIVE_SCORE_SAMPLE_RATE=0.2
RUN_TTL_SECONDS=604800

# --- demo controls --------------------------------------------------------------
# 1 enables POST /admin/faults on the gateway and the X-Demo-Fault header.
# Turn off outside demos.
DEMO_FAULTS=1

# --- misc -----------------------------------------------------------------------
METRICS_PORT=9100
PROMETHEUS_DISABLE_CREATED_SERIES=True
GF_SECURITY_ADMIN_PASSWORD=change-me
# Host ports (change if something else already uses them)
API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
LOCUST_PORT=8089
